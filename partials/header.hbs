<header class="site-header">
    <div class="wrap site-header-inner">
        <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}}, home">
            {{> "logo"}}
            <span class="brand-name">{{@site.title}}</span>
        </a>

        <nav class="site-nav" aria-label="Primary">{{navigation}}</nav>

        <div class="site-actions">
            <button class="icon-btn" type="button" data-ghost-search aria-label="Search this site">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
            <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color scheme">
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
            </button>
            {{#if @member}}
                <a class="btn-quiet" href="#/portal/account" data-portal="account">Account</a>
            {{else}}
                {{#if @site.members_enabled}}<a class="btn-quiet" href="#/portal/signin" data-portal="signin">Sign in</a>{{/if}}
            {{/if}}
        </div>
    </div>
</header>
