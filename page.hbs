{{!< default}}

{{#post}}
<main id="main">
    <article class="article {{post_class}}">
        {{#if @page.show_title_and_feature_image}}
            <header class="wrap article-header">
                <h1 class="article-title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="lede article-excerpt">{{custom_excerpt}}</p>{{/if}}
            </header>
            {{#if feature_image}}
                <figure class="wrap article-feature">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                    {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
                </figure>
            {{/if}}
        {{else}}
            <h1 class="sr-only">{{title}}</h1>
        {{/if}}
        <div class="gh-content gh-canvas article-body">
            {{content}}
        </div>
    </article>
</main>
{{/post}}
