{{!< default}}

<main id="main" class="wrap archive">
    {{#author}}
    <header class="archive-header">
        <p class="eyebrow">Author</p>
        <h1 class="archive-title">{{name}}</h1>
        {{#if bio}}<p class="lede">{{bio}}</p>{{/if}}
    </header>
    {{/author}}
    <ul class="post-list">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</ul>
    {{pagination}}
</main>
