# Copy to .env and edit. Never commit .env.

# Public domain of the site. No protocol, no trailing slash.
DOMAIN=harness.example.com

# Database password for the "ghost" MySQL user. Choose a long random value, for example:
#   openssl rand -hex 24
# Do not change it after the first start: MySQL only reads it when it creates the database.
DATABASE_PASSWORD=change-me

# Ports Caddy listens on. Leave at 80 and 443: certificates need both reachable from the internet.
# Change them only if something else terminates TLS in front (see _DEPLOYMENT.md).
HTTP_PORT=80
HTTPS_PORT=443

# Mail. Needed for staff logins and invites, password resets, member sign-in and native comments.
# Any SMTP provider works. Port 465 uses implicit TLS (secure=true), port 587 uses STARTTLS (secure=false).
mail__transport=SMTP
mail__options__host=smtp.example.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=postmaster@example.com
mail__options__auth__pass=change-me
mail__from="'Harness Matrix' <noreply@example.com>"

# Optional: pin versions. Defaults are ghost:6-alpine and mysql:8.4.
# Ghost supports MySQL 8.0 and 8.4. Do not move an existing database between major MySQL versions casually.
# GHOST_VERSION=6-alpine
# MYSQL_VERSION=8.4

# Optional: where data lives on the host (bind mounts, easy to back up).
# CONTENT_LOCATION=./data/ghost
# MYSQL_DATA_LOCATION=./data/mysql
